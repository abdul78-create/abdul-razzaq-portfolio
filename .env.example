# Environment variable template
# Copy this to .env.local and fill in real values if needed.
# This portfolio is primarily static — no backend secrets are required
# unless you add a contact form integration (e.g. Resend, Formspree).

# Optional: contact form API key (only needed if a contact endpoint is added)
# RESEND_API_KEY=your_resend_api_key_here

# Optional: set the production URL for canonical links / Open Graph
# NEXT_PUBLIC_SITE_URL=https://your-portfolio.onrender.com
